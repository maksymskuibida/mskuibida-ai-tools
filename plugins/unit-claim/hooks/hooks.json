{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || { echo 'Refused by the unit-claim plugin: python3 is not installed, so a Unit claim cannot be checked. Install Python 3 or disable the plugin.' >&2; exit 2; }; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claim_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claim_guard.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claim_guard.py\""
          }
        ]
      }
    ]
  }
}
