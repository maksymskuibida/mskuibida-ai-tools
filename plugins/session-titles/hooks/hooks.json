{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Skill|AskUserQuestion|mcp__ccd_session_mgmt__set_session_title",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__ccd_session_mgmt__set_session_title",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
