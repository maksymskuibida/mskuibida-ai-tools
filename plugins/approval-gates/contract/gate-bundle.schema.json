{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maksymskuibida/mskuibida-ai-tools/plugins/approval-gates/contract/gate-bundle.schema.json",
  "title": "AI-DLC gate bundle",
  "description": "The file the agent writes at a Unit gate (the plan approval or the unit-end approval of a Unit claimed with the unit-end rhythm). A page renders it. The shape is renderer-neutral: it carries what to show and how important each piece is, never how to draw it. README.md next to this file is the documented contract; validate_bundle.py checks this schema plus the cross-field rules the README lists.",
  "type": "object",
  "required": ["schema", "page", "id", "createdAt", "header", "sections", "answers"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aidlc-gate-bundle/1" },
    "page": { "enum": ["plan", "unit-end"], "description": "plan: shown at the Code Generation plan approval, the person's one look at every design stage. unit-end: shown at the Unit's single unit-end gate." },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*-(plan|unit-end)-v[0-9]+-[0-9]{8}T[0-9]{4}$", "description": "<intent>-<unit>-<page>-v<revision>-<YYYYMMDDTHHMM>, new for every presentation." },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "header": { "$ref": "#/$defs/header" },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "plan": { "$ref": "#/$defs/plan" },
    "answers": { "type": "array", "items": { "$ref": "#/$defs/answerGroup" } },
    "design": { "$ref": "#/$defs/design" },
    "ids": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/$defs/idDefinition" },
      "description": "What each id the page shows is (US1.1, FR1.4, BR1.2, Q3, R-01, ADR-009, ...), keyed by the id: the shared aidlc_ids.py refs over every text of the bundle, nearest the Unit's stage folders. The page makes every id a link with this as its tooltip. unit_bundle.py finalize writes it."
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "idDefinition": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "description": "One id's definition in the project's documents, as aidlc_ids.py gives it.",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "description": "The kind in plain words: Story, Functional requirement, Business rule, Question, Review finding, ..." },
        "title": { "type": "string" },
        "text": { "type": "string", "description": "The start of what the document says of it." },
        "doc": { "type": "string", "description": "The document it is defined in, relative to the intent folder." },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "line": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\n\\r]*[^\\s…]$", "description": "One line: no line break, not ending in a space or an ellipsis (the renderer cuts it off)." },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "anchorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:-]{0,31}$", "description": "A row id as shown (FD R-06, A-2, E-1). Its anchor is the id with every run of characters outside [A-Za-z0-9._-] replaced by a hyphen." },
    "revision": { "type": "integer", "minimum": 2, "maximum": 99 },
    "label": { "enum": ["critical", "high", "medium", "low", "core", "main", "minor"], "description": "critical: wrong data, security, or hard to undo. high: wrong behaviour the person would see. medium: rework inside this Unit. low: cosmetic or internal. core, main and minor are for the rows of a `built` section only." },
    "ref": {
      "type": "object",
      "required": ["label", "tip", "target"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "tip": { "type": "string", "minLength": 1, "maxLength": 400, "description": "What the reference says, shown on hover and focus." },
        "target": { "type": "string", "pattern": "^(#[A-Za-z0-9._-]+|https?://[^\\s]+|path:[^\\s#]+(#[^\\s]+)?)$", "description": "#<anchor> inside this bundle, an http(s) URL, or path:<repo-relative path>[#<id>] for a record outside the bundle (a renderer links it through header.links.records when given)." }
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "key", "digest"],
      "additionalProperties": false,
      "description": "Where a row was drawn from, so a later revision can tell an untouched row from a changed one. Renderers ignore it.",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
      }
    },
    "header": {
      "type": "object",
      "required": ["project", "intent", "unit", "unitName", "title", "lede", "status", "revision", "revisions", "facts"],
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/$defs/line" },
        "intent": { "type": "string", "minLength": 1 },
        "intentName": { "$ref": "#/$defs/line" },
        "unit": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "unitLabel": { "type": "string", "maxLength": 12 },
        "unitName": { "$ref": "#/$defs/line" },
        "title": { "$ref": "#/$defs/line" },
        "lede": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/line" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 99 },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["n", "note"],
            "additionalProperties": false,
            "properties": {
              "n": { "type": "integer", "minimum": 1, "maximum": 99 },
              "note": { "$ref": "#/$defs/line" },
              "at": { "type": "string" }
            }
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 32 },
              "value": { "type": "string", "minLength": 1, "maxLength": 32 },
              "note": { "type": "string", "maxLength": 80 }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slug", "name", "ran"],
            "additionalProperties": false,
            "properties": {
              "slug": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "ran": { "type": "boolean" },
              "note": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "records": { "type": "string", "pattern": "^https?://", "description": "Base URL a path: target is appended to." },
            "plan": { "type": "string", "description": "Where the approved plan page can be opened (unit-end)." }
          }
        },
        "footer": { "$ref": "#/$defs/text" }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "title", "label", "body", "refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/anchorId" },
        "title": { "$ref": "#/$defs/line" },
        "label": { "$ref": "#/$defs/label" },
        "lookFirst": { "type": "boolean" },
        "body": { "$ref": "#/$defs/text" },
        "where": { "type": "string", "maxLength": 48 },
        "whereIsPath": { "type": "boolean" },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "coveredBy": {
          "type": "object",
          "required": ["text", "settled"],
          "additionalProperties": false,
          "description": "For a reviewer finding: what in the plan or the code settles it, or that nothing does.",
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 80 },
            "settled": { "type": "boolean" }
          }
        },
        "suggestion": { "type": "boolean", "description": "The row proposes something the person may take or leave (Do it / Leave it)." },
        "rev": { "$ref": "#/$defs/revision" },
        "revKind": { "enum": ["new", "changed"] },
        "revNote": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "map": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "description": "A small picture of how the pieces of a `built` section connect.",
      "properties": {
        "caption": { "type": "string", "maxLength": 200 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "title", "weight"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 40 },
              "note": { "type": "string", "maxLength": 60 },
              "weight": { "enum": ["core", "main", "minor", "existing"] },
              "target": { "type": "string", "pattern": "^#[A-Za-z0-9._-]+$" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["key", "kind", "title", "short", "rows"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["narrows", "assumptions", "findings", "visible", "tests", "changes", "unverified", "verified", "failed", "built", "other"] },
        "title": { "$ref": "#/$defs/line" },
        "short": { "type": "string", "minLength": 1, "maxLength": 16 },
        "hint": { "type": "string", "maxLength": 120 },
        "refsLabel": { "type": "string", "maxLength": 16, "description": "The word before a row's references (Was, For, Uses)." },
        "asApproved": { "type": "boolean", "description": "changes only: the design stays as approved; the section holds no rows." },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "map": { "$ref": "#/$defs/map" }
      }
    },
    "step": {
      "type": "object",
      "required": ["n", "title", "layer", "files", "subs", "implements"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/line" },
        "layer": { "enum": ["setup", "tests", "data", "logic", "api", "UI", "infra", "checks", "docs", "other"] },
        "files": { "type": "integer", "minimum": 0 },
        "subs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "rev": { "$ref": "#/$defs/revision" }
            }
          }
        },
        "implements": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "rev": { "$ref": "#/$defs/revision" },
        "revKind": { "enum": ["new", "changed"] },
        "revNote": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/line" },
        "hint": { "type": "string", "maxLength": 120 },
        "path": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "answerGroup": {
      "type": "object",
      "required": ["key", "stage", "title", "file", "questions"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "stage": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/line" },
        "file": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "anchor", "text", "answer"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^Q[0-9]+$" },
              "anchor": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "text": { "$ref": "#/$defs/line" },
              "answer": { "type": "string", "minLength": 1, "maxLength": 600 },
              "proposed": { "type": "string", "maxLength": 600 }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "required": ["bundle", "rows"],
      "additionalProperties": false,
      "description": "unit-end only: the approved plan page, folded to its rows.",
      "properties": {
        "bundle": { "type": "string" },
        "url": { "type": "string" },
        "counts": { "type": "string", "maxLength": 80 },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/anchorId" },
              "title": { "$ref": "#/$defs/line" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the bundle was built from. Renderers ignore it.",
      "properties": {
        "builder": { "type": "string" },
        "records": { "type": "array", "items": { "type": "string" } },
        "previous": { "type": "string" }
      }
    }
  }
}
